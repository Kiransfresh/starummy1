rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function isOwner() {
      return email() == 'kvkmsolutions@gmail.com';
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/adminAccess/$(email()));
    }

    function isDelegatedAdmin() {
      return signedIn()
        && email() != ''
        && exists(/databases/$(database)/documents/adminAccess/$(email()))
        && adminDoc().data.enabled == true;
    }

    function canApprovePayments() {
      return isOwner() || (isDelegatedAdmin() && adminDoc().data.permissions.payments == true);
    }

    function canChangeGameSettings() {
      return isOwner() || (isDelegatedAdmin() && adminDoc().data.permissions.gameSettings == true);
    }

    function canViewUserActivity() {
      return canApprovePayments() || canChangeGameSettings();
    }

    function validWalletTopup() {
      return request.resource.data.requestType == 'wallet_topup'
        && request.resource.data.amountRupees is int
        && request.resource.data.amountRupees >= 10
        && request.resource.data.amountRupees <= 50000
        && request.resource.data.credits == request.resource.data.amountRupees * 10
        && request.resource.data.planId == '';
    }

    function validSubscriptionRequest() {
      return request.resource.data.requestType == 'subscription'
        && request.resource.data.durationDays == 30
        && (
          (request.resource.data.planId == 'basic'
            && request.resource.data.planName == 'Basic'
            && request.resource.data.amountRupees == 999
            && request.resource.data.credits == 6000)
          ||
          (request.resource.data.planId == 'pro'
            && request.resource.data.planName == 'Pro'
            && request.resource.data.amountRupees == 2000
            && request.resource.data.credits == 10000)
        );
    }

    match /adminAccess/{adminEmail} {
      allow read: if isOwner() || (signedIn() && email() == adminEmail);
      allow create, update, delete: if isOwner();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canApprovePayments());

      // A normal user can bootstrap only the standard starter balance.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.coins == 5000;

      // Users may update profile fields, but never their own wallet balance.
      allow update: if signedIn() && (
        canApprovePayments()
        || (
          request.auth.uid == uid
          && request.resource.data.coins == resource.data.coins
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'phone', 'email', 'name', 'avatar', 'updatedAt', 'gamesPlayed', 'gamesWon', 'lastGameResult'
          ])
        )
      );

      allow delete: if false;
    }

    match /walletTopups/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentConfirmed == true
        && request.resource.data.utr is string
        && request.resource.data.utr.size() <= 40
        && request.resource.data.paymentProofDataUrl is string
        && request.resource.data.paymentProofDataUrl.size() <= 400000
        && (
          request.resource.data.paymentProofDataUrl == ''
          || request.resource.data.paymentProofDataUrl.matches('^data:image/(jpeg|png|webp);base64,.*$')
        )
        && (validWalletTopup() || validSubscriptionRequest());

      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || canApprovePayments());

      allow update: if canApprovePayments();
      allow delete: if false;
    }

    match /gameSettings/{docId} {
      allow read: if signedIn();
      allow write: if canChangeGameSettings();
    }

    match /activeGames/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canViewUserActivity());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    match /gameResults/{resultId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || canViewUserActivity());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
